{
  "name": "estado-status",
  "workers_dev": true,
  "routes": [{ "pattern": "estado.watch", "custom_domain": true }],
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node cloudflare/assets.js" },
  "assets": { "directory": ".wrangler/site", "binding": "ASSETS" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "estado-status",
    "database_id": "01bb7c08-b865-44df-b3be-9b87eb971d21",
    "migrations_dir": "cloudflare/migrations"
  }]
}
